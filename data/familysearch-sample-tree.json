	"insights": {
		"description": "Sample survey boards and fact-spotting prompts for Genie Greenie family games. These are pre-aggregated from the mock GedcomX ancestry payload now, and can later be regenerated directly from FamilySearch ancestry responses.",
		"surveyPrompts": [
			{
				"id": "occupations",
				"title": "Occupations and migration",
				"prompt": "Top 8 occupations in this family tree",
				"description": "Guess the jobs that appear most often across this pedigree and look for work patterns passed down through branches.",
				"answerLimit": 8,
				"skillsLearned": [
					"noticing patterns",
					"demographic trends",
					"occupations and migration"
				],
				"source": {
					"endpoint": "GET /platform/tree/ancestry?person={pid}&generations=4",
					"photoPath": "portraits[{personId}].sourceDescriptions[0].links.image-thumbnail.href",
					"derivedFrom": [
						{
							"path": "ancestry.persons[].facts[]",
							"matchType": "http://gedcomx.org/Occupation",
							"field": "value",
							"note": "FamilySearch occupation facts are person-level facts with a typed value."
						}
					]
				},
