		"twoTruthsOneLiePrompts": [
			{
				"id": "terry-briggs-parent-lie",
				"personId": "LXDB-Q7B",
				"adjacentPersonId": "KWZQ-TDD",
				"adjacentRelationship": "parent",
				"title": "Parent branch mix-up",
				"prompt": "Which statement is the lie?",
				"description": "Two facts belong to Terry Wallace Briggs. One fact actually belongs to his father in the FamilySearch child-and-parents relationship.",
				"source": {
					"endpoint": "GET /platform/tree/ancestry?person={pid}&generations=4",
					"photoPath": "portraits[{personId}].sourceDescriptions[0].links.image-thumbnail.href",
					"derivedFrom": [
						{
							"path": "ancestry.persons[]",
							"field": "display.name"
						},
						{
							"path": "ancestry.persons[].facts[]",
							"field": "date.original, place.original, value"
						},
						{
							"path": "ancestry.childAndParentsRelationships[]",
							"transform": "Use the child-to-father or child-to-mother resourceId link to select an adjacent ancestor."
						}
					]
				},
				"statements": [
					{
						"id": "terry-briggs-truth-1",
						"text": "He was born in 1952 in Idaho Falls, Idaho.",
